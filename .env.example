# Copie este arquivo para .env e preencha os valores reais.
# O .env nunca vai para o Git.

# Groq (modelo de linguagem)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama (embeddings, roda fora do Docker)
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
# Tempo que o Ollama mantém o modelo na memória sem uso (evita ~2,5 s na pergunta seguinte)
OLLAMA_KEEP_ALIVE=1h

# PostgreSQL + pgvector (Docker)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Área do RH (/rh): chave de acesso. Gere uma com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
RH_CHAVE_ACESSO=

# Dias que as perguntas registradas ficam guardadas (depois são apagadas)
RETENCAO_DIAS=180
